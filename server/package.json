{
  "name": "WhistleIRC",
  "private": true,
  "version": "0.1.1-alpha",
  "description": "WhistleIRC WebSocket and Bancho IRC bridge",
  "main": "src/index.js",
  "bin": "dist/bundle.js",
  "scripts": {
    "start": "tsx src/index.js",
    "bundle": "esbuild src/index.js --bundle --platform=node --outfile=dist/bundle.js",
    "build": "node build.js",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@yao-pkg/pkg": "^6.22.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "resedit-cli": "^3.1.0"
  },
  "pkg": {
    "assets": [
      "static/**/*"
    ],
    "targets": [
      "node22-win-x64",
      "node22-win-arm64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-linux-x64",
      "node22-linux-arm64"
    ],
    "outputPath": "build"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.24.2": true
  }
}
